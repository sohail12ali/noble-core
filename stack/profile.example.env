# Stack profile. Copy to stack/profile.env, edit, then: python3 scripts/core/apply_stack.py
# Format: KEY=value (no spaces around =). Commands run from the repo root through `sh -c`.
# A value of "none" (or empty) means "not used"; with everything none the output equals layer 0.

STACK_NAME=my-project

# Fragments to render into the slot skills: stack/fragments/<kind>/<value>.md
BACKEND=none
FRONTEND=none
DATABASE=none
TESTING=none

# Pinned toolchain versions (rendered into docs/stack-versions.md). Any VERSION_<TOOL>=x works.
# VERSION_RUNTIME=
# VERSION_DATABASE=

# Backend commands
BACKEND_BUILD_CMD=
BACKEND_LINT_CMD=
BACKEND_TEST_CMD=
BACKEND_RUN_CMD=

# Frontend commands
FRONTEND_BUILD_CMD=
FRONTEND_LINT_CMD=
FRONTEND_TEST_CMD=
FRONTEND_RUN_CMD=

# Database commands. DB_TARGET must be local or dev: scripts/core/db.sh refuses anything else.
DB_TARGET=local
DB_STATUS_CMD=
DB_MIGRATE_CMD=
DB_SEED_CMD=
DB_RESET_CMD=
DB_SNAPSHOT_CMD=
DB_RESTORE_CMD=
# Read-only inspection command (e.g. a client wrapper using a read-only role).
DB_READONLY_CMD=

# Gates (see testing skill)
# focused: commands for what you are building; changed: the merge gate; all: everything CI runs.
TEST_FOCUSED_CMD=
TEST_CHANGED_CMD=
TEST_ALL_CMD=
