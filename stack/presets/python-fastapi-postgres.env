# Preset: Python FastAPI API + React (Vite) client + PostgreSQL. Edit paths to your layout.
STACK_NAME=python-fastapi-postgres
BACKEND=python-fastapi
FRONTEND=react
DATABASE=postgres
TESTING=python-pytest

VERSION_PYTHON=3.12
VERSION_NODE=22
VERSION_POSTGRESQL=17

BACKEND_BUILD_CMD="uv sync --frozen"
BACKEND_LINT_CMD="ruff check . && ruff format --check . && mypy app"
BACKEND_TEST_CMD="pytest -q"
BACKEND_RUN_CMD="uvicorn app.main:app --reload"

FRONTEND_BUILD_CMD="npm run build --prefix web"
FRONTEND_LINT_CMD="npx tsc --noEmit -p web && npx eslint web/src"
FRONTEND_TEST_CMD="npx vitest run --root web"
FRONTEND_RUN_CMD="npm run dev --prefix web"

DB_TARGET=local
DB_STATUS_CMD="alembic current"
DB_MIGRATE_CMD="alembic upgrade head"
DB_SEED_CMD="python -m app.seed"
DB_RESET_CMD="sh db/reset-dev.sh"
DB_SNAPSHOT_CMD='pg_dump --format=custom --file=../core-queue/dev.dump $PGDATABASE'
DB_RESTORE_CMD='pg_restore --clean --if-exists --dbname=$PGDATABASE ../core-queue/dev.dump'
DB_READONLY_CMD='psql -U readonly_role -d $PGDATABASE'

TEST_FOCUSED_CMD="pytest -x -q"
TEST_CHANGED_CMD="sh scripts/test-changed.sh"
TEST_ALL_CMD="pytest -q && npx vitest run --root web"
