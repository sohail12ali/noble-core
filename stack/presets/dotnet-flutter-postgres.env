# Preset: .NET backend + Flutter client + PostgreSQL. Edit paths (App.slnx, tool locations) to your layout.
STACK_NAME=dotnet-flutter-postgres
BACKEND=dotnet
FRONTEND=flutter
DATABASE=postgres
TESTING=dotnet-flutter

VERSION_DOTNET_SDK=10.x
VERSION_FLUTTER=3.x
VERSION_POSTGRESQL=18

BACKEND_BUILD_CMD="dotnet build backend/App.slnx"
BACKEND_LINT_CMD="dotnet build backend/App.slnx -warnaserror --no-restore"
BACKEND_TEST_CMD="dotnet test --solution backend/App.slnx"
BACKEND_RUN_CMD="dotnet run --project backend/src/App.Api"

FRONTEND_BUILD_CMD="cd app && flutter build web"
FRONTEND_LINT_CMD="cd app && flutter analyze"
FRONTEND_TEST_CMD="cd app/packages/core && flutter test"
FRONTEND_RUN_CMD="cd app/apps/member && flutter run -d chrome"

DB_TARGET=local
DB_STATUS_CMD="dotnet run --project backend/tools/DbMigrate -- status"
DB_MIGRATE_CMD="dotnet run --project backend/tools/DbMigrate -- migrate"
DB_SEED_CMD="dotnet run --project backend/tools/DbMigrate -- seed"
DB_RESET_CMD="dotnet run --project backend/tools/DbMigrate -- reset"
DB_SNAPSHOT_CMD='pg_dump --format=custom --file=../core-queue/dev.dump $PGDATABASE'
DB_RESTORE_CMD='pg_restore --clean --if-exists --dbname=$PGDATABASE ../core-queue/dev.dump'
DB_READONLY_CMD='psql -U readonly_role -d $PGDATABASE'

TEST_FOCUSED_CMD="dotnet test --project backend/tests/UnitTests"
TEST_CHANGED_CMD="python3 scripts/test-changed.py"
TEST_ALL_CMD="dotnet test --solution backend/App.slnx && cd app && flutter test"
