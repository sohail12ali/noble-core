# Preset: Node/TypeScript API + React (Vite) client + PostgreSQL. Edit workspace paths to your layout.
STACK_NAME=node-react-postgres
BACKEND=node-ts
FRONTEND=react
DATABASE=postgres
TESTING=node-vitest

VERSION_NODE=22
VERSION_TYPESCRIPT=5.x
VERSION_POSTGRESQL=17

BACKEND_BUILD_CMD="npm run build --workspace api"
BACKEND_LINT_CMD="npx tsc --noEmit -p api && npx eslint api/src"
BACKEND_TEST_CMD="npx vitest run --root api"
BACKEND_RUN_CMD="npm run dev --workspace api"

FRONTEND_BUILD_CMD="npm run build --workspace web"
FRONTEND_LINT_CMD="npx tsc --noEmit -p web && npx eslint web/src"
FRONTEND_TEST_CMD="npx vitest run --root web"
FRONTEND_RUN_CMD="npm run dev --workspace web"

DB_TARGET=local
DB_STATUS_CMD="npx node-pg-migrate --migrations-dir db/migrations list"
DB_MIGRATE_CMD="npx node-pg-migrate --migrations-dir db/migrations up"
DB_SEED_CMD='psql -d $PGDATABASE -f db/seed/seed.sql'
DB_RESET_CMD="sh db/reset-dev.sh"
DB_SNAPSHOT_CMD='pg_dump --format=custom --file=../core-queue/dev.dump $PGDATABASE'
DB_RESTORE_CMD='pg_restore --clean --if-exists --dbname=$PGDATABASE ../core-queue/dev.dump'
DB_READONLY_CMD='psql -U readonly_role -d $PGDATABASE'

TEST_FOCUSED_CMD="npx vitest run --changed"
TEST_CHANGED_CMD="npx vitest run --changed origin/main && npx tsc --noEmit"
TEST_ALL_CMD="npx vitest run && npx playwright test"
