# Owner's settings for unattended runs. Plain KEY=value, read by run/loop.sh and scripts/*.sh.
# Agents do not edit this file during a run; the loop reports it if the gate changes.

BASE_BRANCH=main
PROTECTED_BRANCHES="main"

# The gate: one command, run from the repo root, exit 0 means green. Empty means "no gate yet",
# which is reported as unverified, never as a pass.
VERIFY_CMD=""

# Engine: claude | cursor. MODEL empty uses the engine's default (usually the right choice).
ENGINE=claude
MODEL=
# Full replacement for the engine command if you need different flags; reads the prompt on stdin.
ENGINE_CMD=""

# Limits. The loop stops at whichever comes first.
MAX_ITERATIONS=40
MAX_HOURS=10
ITERATION_TIMEOUT_MIN=120
BUDGET_USD_PER_ITERATION=20
# Iterations in a row with no new commit before the loop gives up.
MAX_STALLS=3
# An iteration that fails in under a minute is usually a usage limit or lost sign-in: wait, then retry.
RETRY_SLEEP_MIN=15

# When the loop ends: none | push (push the run branch) | pr (push and open a draft pull request).
ON_FINISH=none
