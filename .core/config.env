# Core configuration. Sourced by scripts/core/*.sh and scripts/hooks/*.sh (POSIX sh, KEY=value only).
# Change values here, not in the scripts.

# Integration branch that work branches are cut from and merged into.
CORE_BASE_BRANCH=main
# Branches nobody commits to or pushes to directly (space separated). Add dev/qc if you use them.
CORE_PROTECTED_BRANCHES="main"
# Allowed work-branch types: <type>/<kebab-name>
CORE_WORK_TYPES="feature|bugfix|hotfix|docs|chore"
# Where worktrees go (sibling folders of the repo) and where queue files and logs live (outside the repo).
CORE_WORKTREE_PREFIX="../"
CORE_QUEUE_DIR="../core-queue"
# Run state.
CORE_LEDGER=".autonomous/ledger.md"
CORE_STATUS_FILE="docs/STATUS.md"
CORE_STATUS_MAX_LINES=40
CORE_STATUS_MAX_BYTES=3072
CORE_SKILL_MAX_BYTES=6144
# Minimum free disk (GB) before a long run starts.
CORE_MIN_FREE_GB=10
# Merge policy for unattended runs: pr-squash | pr-merge | none (leave branches for review).
CORE_MERGE_MODE="pr-squash"
